ORCHESTRATOR_TEMPERATURE=0.1
ORCHESTRATOR_MAX_TOKENS=300

AGENT_TEMPERATURE=0.1
AGENT_MAX_TOKENS=700

LLM_ORCHESTRATOR_PROVIDER=openrouter
LLM_SPECIALIZED_AGENT_PROVIDER=openrouter
LLM_DIALOG_PROVIDER=openrouter
LLM_ADAPTATION_PROVIDER=openrouter
LLM_NPA_PROVIDER=openrouter
LLM_METHOD_DOCS_PROVIDER=openrouter
LLM_INTERNET_RESOURCES_PROVIDER=openrouter
LLM_STATISTICS_SQL_PROVIDER=openrouter
LLM_STATISTICS_ANSWER_PROVIDER=openrouter
LLM_STRUCTURED_DATA_PROVIDER=openrouter

LLM_ORCHESTRATOR_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_SPECIALIZED_AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_DIALOG_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
LLM_ADAPTATION_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
LLM_NPA_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
LLM_METHOD_DOCS_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
LLM_INTERNET_RESOURCES_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
LLM_STATISTICS_SQL_MODEL=qwen/qwen3-coder:free
LLM_STATISTICS_ANSWER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
LLM_STRUCTURED_DATA_MODEL=qwen/qwen3-next-80b-a3b-instruct:free

NVIDIA_API_KEY=key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro
NVIDIA_REQUEST_TIMEOUT=240.0
NVIDIA_MAX_RETRIES=0

OPENROUTER_API_KEY=key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
OPENROUTER_REQUEST_TIMEOUT=180
OPENROUTER_MAX_RETRIES=1

OPENAI_API_KEY=key

DASHSCOPE_API_KEY=key
DASHSCOPE_BASE_URL=url

YANDEX_CLOUD_API_KEY=key
YANDEX_CLOUD_FOLDER=folder
YANDEX_CLOUD_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_CLOUD_MODEL=yandexgpt-lite
YANDEX_WEB_SEARCH_ENABLED=true
YANDEX_WEB_SEARCH_TIMEOUT=120
YANDEX_WEB_SEARCH_MAX_RESULTS=4
YANDEX_WEB_SEARCH_MAX_OUTPUT_TOKENS=2500

DATABASE_URL=url
DB_DATABASE=climate
DB_USERNAME=username
DB_PASSWORD=password
DB_HOST=127.0.0.1
DB_PORT=5433

ADAPTATION_TABLE=adaptation_embeddings
NPA_TABLE=npa_embeddings
METHOD_DOCS_TABLE=method_embeddings
INTERNET_RESOURCES_TABLE=internet_embeddings
FLOOD_OBJECTS_TABLE=flood_embeddings

EMBED_MODEL=intfloat/multilingual-e5-large-instruct
EMBED_DIM=1024

GOOGLE_SEARCH_SCRAPE_ENABLED=1
GOOGLE_SEARCH_HL=ru
GOOGLE_SEARCH_GL=ru
GOOGLE_SEARCH_TIMEOUT=15
GOOGLE_SEARCH_MAX_RESULTS=5
GOOGLE_AI_OVERVIEW_MAX_CHARS=6000

QWEN_MODEL=qwen3.5-397b-a17b
QWEN_ENABLE_THINKING=1

DATA_PATH=./data
STATISTICS_PATH=./data/Statistics_MO

LOG_LEVEL=INFO

APP_TITLE=CARBON_AI

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
